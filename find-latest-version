package ea_rubygem_mizuho::find_latest_version;

use strict;
use warnings;

use FindBin;
use lib "../ea-tools/lib/ea4_tool";    # assumes ea-tools is checked out next to this repo
use ea4_tool::util ();

my $release;

ea4_tool::util::find_latest_version( \&_get_required, \&_add_sum ) if !caller();

###############
#### helpers ##
###############

sub _get_required {
    my ($http) = @_;

    $release = ea4_tool::util::get_rubygem_newest_release( $http, gem => "mizuho", ruby => "2.7" );

    return @{$release}{qw(version url name)};
}

sub _add_sum {
    my ( $http, $hr ) = @_;

    $hr->{tarball}{sum} = { hex => $release->{sha256}, type => "sha256" };

    return 1;
}
